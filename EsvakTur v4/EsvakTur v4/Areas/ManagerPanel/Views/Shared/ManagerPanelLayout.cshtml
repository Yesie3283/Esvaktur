<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esvak Panel - @ViewBag.Title</title>
    <!-- FontAwesome ve Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Assets/Css/ManagerPanelStyle.css")" rel="stylesheet" type="text/css" />
    @RenderSection("head", required: false)
</head>
<body>
    <div class="Layout">
        <!-- Sol Menü -->
        <aside class="sidebar">
            <div class="brandbar">
                <img src="~/Areas/Assets/Images/esvak-logo.png" class="logo-img" />
                <span class="brand-text">ESVAK PANEL</span>
            </div>
            <nav class="menu-items">
                <ul>
                    <li class="@(ViewBag.Title == "Dashboard" ? "active" : "")">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="fa-solid fa-chart-line"></i> Dashboard
                        </a>
                    </li>
                    <li class="@(ViewBag.Title == "Category Management" ? "active" : "")">
                        <a href="#">
                            <i class="fa-solid fa-tags"></i> Categories
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="fa-solid fa-plane"></i> Tours
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Ana İçerik Alanı -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
</body>
</html>