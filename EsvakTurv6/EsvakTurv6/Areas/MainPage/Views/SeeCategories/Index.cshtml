@model IEnumerable<EsvakTurv6.Models.TourCategories>

@{
    ViewBag.Title = "Tur Kategorileri";
    Layout = "~/Areas/MainPage/Views/Shared/MainLayout.cshtml";
}

<style>
    .category-header {
        background: #111926;
        padding: 60px 0;
    }

    .category-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
        background: #fff;
    }

        .category-card:hover {
            transform: translateY(-4px);
            border-color: #ff6b00;
            box-shadow: 0 10px 20px rgba(255, 107, 0, 0.08) !important;
        }

    .category-icon {
        width: 50px;
        height: 50px;
        background-color: rgba(255, 107, 0, 0.1);
        color: #ff6b00;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .btn-orange-outline {
        color: #ff6b00;
        border: 1px solid #ff6b00;
        background: transparent;
        transition: all 0.2s ease;
    }

        .btn-orange-outline:hover {
            background-color: #ff6b00;
            color: white;
        }
</style>


<section class="category-header text-white text-center mb-5">
    <div class="container">
        <span class="badge text-uppercase mb-2 px-3 py-2" style="background-color: #ff6b00;">Keşfetmeye Başlayın</span>
        <h1 class="display-5 fw-bold m-0">Tur Kategorilerimiz</h1>
        <p class="lead text-white-50 mt-2 mb-0">Ruhunuza ve zevkinize en uygun tatil rotasını seçin.</p>
    </div>
</section>


<section class="container my-5 min-vh-50">
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card category-card h-100 p-3 shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <div>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="category-icon me-3">
                                        <i class="bi bi-compass"></i>
                                    </div>
                                    <h4 class="fw-bold text-dark m-0">@item.Name</h4>
                                </div>
                                <p class="text-muted small m-0 mb-4">
                                    Bu kategori altındaki en özel tur rotalarını ve detayları inceleyin.
                                </p>
                            </div>

                           
                            <a href="@Url.Action("Index", "SeeToursByCategories", new { id = item.ID, area = "MainPage" })" class="btn btn-orange-outline rounded-pill w-100 py-2 fw-semibold small">
                                Turları İncele <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-folder-x fs-1 text-muted"></i>
                <h4 class="text-muted mt-3">Henüz kategori eklenmemiş.</h4>
                <p class="text-muted small">Admin panelini kullanarak hemen yeni bir tur kategorisi ekleyebilirsiniz.</p>
            </div>
        }
    </div>
</section>