<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Esvak Tour</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f9fa;
            color: #212529;
        }
        
        .navbar {
            backdrop-filter: blur(10px);
            background-color: rgba(255, 255, 255, 0.9) !important;
            transition: all 0.3s ease;
        }

        .nav-link {
            font-weight: 500;
            color: #495057 !important;
            padding: 0.5rem 1rem !important;
            transition: color 0.2s ease;
        }

            .nav-link:hover, .nav-link.active {
                color: #ff6b00 !important; 
            }
       
        .hover-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .hover-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 1rem 3rem rgba(0,0,0,.08) !important;
            }
        footer {
            background-color: #111926;
            color: #a0aec0;
        }

            footer h5 {
                color: #ffffff;
                font-weight: 600;
            }

            footer a {
                color: #a0aec0;
                text-decoration: none;
                transition: color 0.2s;
            }

                footer a:hover {
                    color: #ff6b00;
                }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark" href="@Url.Action("Index", "Home")">
                <img src="~/Assets/Images/esvak-logo.png" alt="Esvak Tour" height="35" onerror="this.style.display='none'">
                <span class="ms-2 fw-bold text-uppercase" style="letter-spacing: 1px;">Esvak<span style="color:#ff6b00;">Tour</span></span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-2">
                    <li class="nav-item"><a class="nav-link active" href="#">Ana Sayfa</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Turlarımız</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Kategoriler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Haberler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">İletişim</a></li>
                </ul>
                @*<div class="ms-lg-3">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "ManagerPanel" })" class="btn btn-dark btn-sm rounded-pill px-3">Yönetim Paneli</a>
                </div>*@
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="mb-3">Esvak<span style="color:#ff6b00;">Tour</span></h5>
                    <p class="small text-warning">Unutulmaz anılar biriktirmeniz için en özel rotaları modern ve güvenli seyahat çözümleriyle sunuyoruz.</p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2 offset-lg-2">
                    <h5>Keşfet</h5>
                    <ul class="list-unstyled d-grid gap-2 small mt-3">
                        <li><a href="#">Biz Kimiz?</a></li>
                        <li><a href="#">Kapadokya Turları</a></li>
                        <li><a href="#">Yurtdışı Turları</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Bilgi Merkezleri</h5>
                    <ul class="list-unstyled d-grid gap-2 small mt-3">
                        <li><a href="#">Sözleşmeler</a></li>
                        <li><a href="#">Sıkça Sorulanlar</a></li>
                        <li><a href="#">Kişisel Veriler</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h5>İletişim</h5>
                    <ul class="list-unstyled d-grid gap-2 small mt-3">
                        <li><i class="bi bi-geo-alt me-2"></i>Eskişehir, Türkiye</li>
                        <li><i class="bi bi-telephone me-2"></i>+90 (544) 744 39 65</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="row small">
                <div class="col-md-6 text-center text-md-start">
                    <p class="m-0">&copy; @DateTime.Now.Year EsvakTour. Tüm hakları saklıdır.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>