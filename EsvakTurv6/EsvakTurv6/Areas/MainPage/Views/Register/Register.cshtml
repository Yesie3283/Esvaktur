@model EsvakTurv6.Models.Users

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm p-4 rounded-3 bg-white">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark">Aramıza Katıl</h2>
                        <p class="text-muted small">Yeni rotaları keşfetmek için hemen hesap oluşturun.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger text-center small py-2 shadow-sm border-0">
                            @Html.ValidationSummary(true, "")
                            @Html.ValidationMessage("Email")
                        </div>
                    }

                    @using (Html.BeginForm("Register", "Register", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Ad Soyad</label>
                            <input type="text" name="Name" class="form-control rounded-pill px-3" required placeholder="Adınız Soyadınız">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Kullanıcı Adı</label>
                            <input type="text" name="UserName" class="form-control rounded-pill px-3" required placeholder="kullaniciadi">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">E-posta</label>
                            <input type="email" name="Email" class="form-control rounded-pill px-3" required placeholder="ornek@mail.com">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Telefon</label>
                            <input type="tel" name="PhoneNumber" class="form-control rounded-pill px-3" required placeholder="05xx xxx xx xx">
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold">Şifre</label>
                            <input type="password" name="Password" class="form-control rounded-pill px-3" required placeholder="••••••">
                        </div>

                        <button type="submit" class="btn btn-warning w-100 rounded-pill py-2.5 fw-bold text-dark mb-3" style="background-color: #ff6b00; border: none;">
                            Kayıt Ol
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Zaten hesabınız var mı?</span>
                            <a href="@Url.Action("Login", "Register")" class="small fw-bold text-decoration-none" style="color: #ff6b00;">Giriş Yap</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>