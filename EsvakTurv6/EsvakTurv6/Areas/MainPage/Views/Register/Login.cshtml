@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm p-4 rounded-3 bg-white">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark">Hoş Geldiniz</h2>
                        <p class="text-muted small">Hesabınıza giriş yaparak turlarınızı yönetin.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger text-center small py-2 shadow-sm border-0">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    @using (Html.BeginForm("Login", "Register", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">E-posta Adresi</label>
                            <input type="email" name="Email" class="form-control rounded-pill px-3" required placeholder="ornek@mail.com">
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold">Şifre</label>
                            <input type="password" name="Password" class="form-control rounded-pill px-3" required placeholder="••••••">
                        </div>

                        <button type="submit" class="btn btn-warning w-100 rounded-pill py-2.5 fw-bold text-dark mb-3" style="background-color: #ff6b00; border: none;">
                            Giriş Yap
                        </button>

                        <div class="text-center">
                            <span class="text-muted small">Henüz hesabınız yok mu?</span>
                            <a href="@Url.Action("Register", "Register")" class="small fw-bold text-decoration-none" style="color: #ff6b00;">Hemen Kayıt Ol</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>