@{
    ViewBag.Title = "Manager Login";
    // Giriş sayfasında ana menü ve footer görünmesin diye Layout'u null (boş) yapıyoruz
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EsvakTour - Yönetim Paneli Girişi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            border: none;
        }

        .form-control:focus {
            border-color: #ff6b00;
            box-shadow: 0 0 0 0.25rem rgba(255, 107, 0, 0.25);
        }

        .btn-login {
            background-color: #ff6b00;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                background-color: #e05e00;
                color: white;
                transform: translateY(-1px);
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="card login-card shadow-lg p-4">
                    <div class="card-body">


                        <div class="text-center mb-4">
                            <h4 class="fw-bold text-dark m-0">ESVAK<span style="color:#ff6b00;">TOUR</span></h4>
                            <p class="text-muted small mt-1">Yönetici Yönetim Konsolu</p>
                        </div>

                      
                        @using (Html.BeginForm("Index", "ManagerLogIn", new { area = "ManagerPanel" }, FormMethod.Post))
                        {
                            
                            @Html.AntiForgeryToken()

                           
                            if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger p-2 small border-0 rounded-3 mb-3">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @Html.ValidationSummary(true, "")
                                </div>
                            }

                            
                            <div class="mb-3">
                                <label for="NickName" class="form-label small fw-semibold text-secondary">Takma Ad (Nick Name)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control bg-light border-start-0 ps-0" id="NickName" name="NickName" placeholder="Kullanıcı adınızı girin" required autocomplete="off">
                                </div>
                            </div>

                           
                            <div class="mb-4">
                                <label for="Password" class="form-label small fw-semibold text-secondary">Şifre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                    <input type="password" class="form-control bg-light border-start-0 ps-0" id="Password" name="Password" placeholder="••••••••" required>
                                </div>
                            </div>

                          
                            <div class="d-grid">
                                <button type="submit" class="btn btn-login py-2 rounded-pill shadow-sm">Giriş Yap</button>
                            </div>
                        }

                        <div class="text-center mt-4">
                            <a href="@Url.Action("Index", "MainPage", new { area = "MainPage" })" class="text-decoration-none small text-muted">
                                <i class="bi bi-arrow-left me-1"></i> Ana Sayfaya Dön
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>