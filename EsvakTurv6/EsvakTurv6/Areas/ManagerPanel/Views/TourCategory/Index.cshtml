@model IEnumerable<EsvakTurv6.Models.TourCategories>

@{
    ViewBag.Title = "Tour Categories";
    Layout = "~/Areas/ManagerPanel/Views/Shared/ManagerPanelLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold mb-0">Tour Categories</h3>
        <a href="@Url.Action("Create", "TourCategory", new { area = "ManagerPanel" })" class="btn btn-primary btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add New Category
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-4" style="width: 10%">ID</th>
                            <th scope="col" style="width: 25%">Name</th>
                            <th scope="col" style="width: 35%">Description</th>
                            <th scope="col" style="width: 15%">Active</th>
                            <th scope="col" class="pe-4 text-end" style="width: 15%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-secondary fw-medium">#@item.ID</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@item.Name</span>
                                    </td>
                                    <td>
                                        <span class="text-muted text-truncate d-inline-block" style="max-width: 300px;" title="@item.Description">
                                            @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill">Passive</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Edit", "TourCategory", new { area = "ManagerPanel", id = item.ID })" class="btn btn-sm btn-outline-warning border-0" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                                <a href="@Url.Action("Details", "TourCategory", new { area = "ManagerPanel", id = item.ID })" class="btn btn-sm btn-outline-info border-0" title="Details">
                                                    <i class="bi bi-eye-fill"></i>
                                                </a>
                                            @using (Html.BeginForm("Delete", "TourCategory", new { area = "ManagerPanel", id = item.ID }, FormMethod.Post, new { target = "silmeHavuzu", style = "display:inline;" }))
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Are you sure you want to delete this category?')" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                                    No categories found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<iframe name="silmeHavuzu" style="display:none;"></iframe>