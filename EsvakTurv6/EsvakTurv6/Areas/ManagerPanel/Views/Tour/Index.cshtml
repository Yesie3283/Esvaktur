@model IEnumerable<EsvakTurv6.Models.Tours>

@{
    ViewBag.Title = "Tours List";
    Layout = "~/Areas/ManagerPanel/Views/Shared/ManagerPanelLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold mb-0">Tours Management</h3>
        <a href="@Url.Action("Create", "Tour", new { area = "ManagerPanel" })" class="btn btn-primary btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add New Tour
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-4" style="width: 8%">ID</th>
                            <th scope="col" style="width: 8%">Image</th>
                            <th scope="col" style="width: 20%">Tour Title</th>
                            <th scope="col" style="width: 15%">Category</th>
                            <th scope="col" style="width: 12%">Price</th>
                            <th scope="col" style="width: 12%">Tour Date</th>
                            <th scope="col" style="width: 10%">Status</th>
                            <th scope="col" class="pe-4 text-end" style="width: 15%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-secondary fw-medium">#@item.ID</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath" class="rounded border" style="width: 45px; height: 45px; object-fit: cover;" alt="Tour Image" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded border d-flex align-items-center justify-content-center text-muted" style="width: 45px; height: 45px;">
                                                <i class="bi bi-image small"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark d-block">@item.Title</span>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;" title="@item.Description">
                                            @(string.IsNullOrEmpty(item.Description) ? "No description" : item.Description)
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.TourCategories != null ? item.TourCategories.Name : "Uncategorized")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.Price.ToString("N2") ₺</span>
                                    </td>
                                    <td>
                                        <span class="small text-secondary">
                                            <i class="bi bi-calendar3 me-1"></i> @item.TourTime.ToString("dd.MM.yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill">Passive</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", "Tour", new { area = "ManagerPanel", id = item.ID })" class="btn btn-sm btn-outline-info border-0" title="Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            <a href="@Url.Action("Edit", "Tour", new { area = "ManagerPanel", id = item.ID })" class="btn btn-sm btn-outline-warning border-0" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @using (Html.BeginForm("Delete", "Tour", new { area = "ManagerPanel", id = item.ID }, FormMethod.Post, new { target = "silmeHavuzu", style = "display:inline;" }))
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Are you sure you want to delete this tour?')" title="Delete">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                                    No tours found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<iframe name="silmeHavuzu" style="display:none;"></iframe>