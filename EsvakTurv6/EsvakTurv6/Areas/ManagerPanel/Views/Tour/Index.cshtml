@model IEnumerable<EsvakTurv6.Models.Tours>

@{
    ViewBag.Title = "Turlar";
    Layout = "~/Areas/ManagerPanel/Views/Shared/ManagerPanelLayout.cshtml";
}

<div class="container-fluid py-2">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0">
                <i class="bi bi-plane-departure me-2" style="color:#ff6b00;"></i>Tur Yönetimi
            </h3>
            <p class="text-muted small m-0">Sistemdeki tüm turları listeleyebilir, düzenleyebilir veya yeni tur ekleyebilirsiniz.</p>
        </div>
        <a href="@Url.Action("Create", "Tour", new { area = "ManagerPanel" })"
           class="btn text-white fw-semibold px-4 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2"
           style="background-color: #ff6b00; border: none;">
            <i class="bi bi-plus-circle-fill"></i> Yeni Tur Ekle
        </a>
    </div>


    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 7%">#ID</th>
                        <th style="width: 8%">Görsel</th>
                        <th style="width: 22%">Tur Başlığı</th>
                        <th style="width: 15%">Kategori</th>
                        <th style="width: 12%">Fiyat</th>
                        <th style="width: 13%">Tur Tarihi</th>
                        <th style="width: 10%">Durum</th>
                        <th class="text-end pe-4" style="width: 13%">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.ID</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" class="rounded-3 border shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-3 border d-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 48px; height: 48px;">
                                            <i class="bi bi-image fs-5 text-secondary opacity-50"></i>
                                        </div>
                                    }
                                </td>


                                <td>
                                    <span class="fw-bold text-dark d-block mb-1">@item.Title</span>
                                    <span class="text-muted extra-small text-truncate d-inline-block" style="max-width: 220px; font-size: 0.8rem;" title="@item.Description">
                                        @(string.IsNullOrEmpty(item.Description) ? "Açıklama belirtilmemiş" : item.Description)
                                    </span>
                                </td>


                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-medium">
                                        <i class="bi bi-tag-fill me-1 text-muted"></i>
                                        @(item.TourCategories != null ? item.TourCategories.Name : "Kategorisiz")
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-bold" style="color: #ff6b00;">₺@item.Price.ToString("N2")</span>
                                </td>


                                <td>
                                    <span class="small text-secondary">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>@item.TourTime.ToString("dd.MM.yyyy")
                                    </span>
                                </td>


                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Pasif</span>
                                    }
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden border" role="group">
                                        <a href="@Url.Action("Details", "Tour", new { area = "ManagerPanel", id = item.ID })"
                                           class="btn btn-sm btn-light text-info border-end" title="Detaylar">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <a href="@Url.Action("Edit", "Tour", new { area = "ManagerPanel", id = item.ID })"
                                           class="btn btn-sm btn-light text-warning border-end" title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @using (Html.BeginForm("Delete", "Tour", new { area = "ManagerPanel", id = item.ID }, FormMethod.Post, new { target = "silmeHavuzu", style = "display:inline;" }))
                                        {
                                            <button type="submit" class="btn btn-sm btn-light text-danger border-0 h-100"
                                                    onclick="return confirm('#@item.ID numaralı turu silmek istediğinize emin misiniz?')" title="Sil">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Kayıtlı hiçbir tur bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<iframe name="silmeHavuzu" style="display:none;"></iframe>