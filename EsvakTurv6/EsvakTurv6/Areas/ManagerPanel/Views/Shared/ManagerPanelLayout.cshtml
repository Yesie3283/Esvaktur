<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esvak Panel - @ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --panel-siyah: #111827; 
            --panel-turuncu: #ff6b00; 
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        
        .sidebar-dark {
            background-color: var(--panel-siyah) !important;
            width: 260px;
            flex-shrink: 0;
        }

            
            .sidebar-dark .nav-link {
                color: #9ca3af !important; 
                font-weight: 500;
                transition: all 0.2s ease-in-out;
            }

                
                .sidebar-dark .nav-link:hover {
                    color: #ffffff !important;
                    background-color: rgba(255, 107, 0, 0.1) !important; 
                }

               
                .sidebar-dark .nav-link.active {
                    background-color: var(--panel-turuncu) !important;
                    color: #ffffff !important;
                    box-shadow: 0 4px 12px rgba(255, 107, 0, 0.3); 
                }

        
        .text-orange {
            color: var(--panel-turuncu) !important;
        }
    </style>
    @RenderSection("head", required: false)
</head>
<body>

    <div class="d-flex min-vh-100">

        <aside class="sidebar-dark d-flex flex-column border-end border-secondary border-opacity-10">

            <div class="p-3 border-bottom d-flex align-items-center bg-white">
                <img src="~/Assets/Images/esvak-logo.png" class="me-2" style="max-height: 35px; width: auto;" />
            </div>

            <nav class="p-3 w-100">
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Dashboard")" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Dashboard" ? "active" : "")">
                            <i class="fa-solid fa-chart-line"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "TourCategory")" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Category Management" ? "active" : "")">
                            <i class="fa-solid fa-tags"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Tour")" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Tour Management" ? "active" : "")">
                            <i class="fa-solid fa-plane"></i> Tours
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="flex-grow-1 p-4 bg-white">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>