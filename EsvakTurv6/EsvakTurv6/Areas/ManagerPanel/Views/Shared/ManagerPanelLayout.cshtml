<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esvak Panel - @ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --panel-siyah: #0f172a;
            --panel-siyah-light: #1e293b;
            --panel-turuncu: #ff6b00;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
        }

        .sidebar-dark {
            background-color: var(--panel-siyah) !important;
            width: 270px;
            flex-shrink: 0;
        }

        .sidebar-header {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .sidebar-heading {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #64748b;
            font-weight: 700;
            padding: 0.75rem 1rem 0.25rem 1rem;
        }

        .sidebar-dark .nav-link {
            color: #94a3b8 !important;
            font-weight: 500;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            transition: all 0.2s ease-in-out;
        }

            .sidebar-dark .nav-link:hover {
                color: #ffffff !important;
                background-color: rgba(255, 107, 0, 0.12) !important;
            }

            .sidebar-dark .nav-link.active {
                background-color: var(--panel-turuncu) !important;
                color: #ffffff !important;
                box-shadow: 0 4px 14px rgba(255, 107, 0, 0.35);
                font-weight: 600;
            }

            .sidebar-dark .nav-link i {
                width: 22px;
                text-align: center;
            }

        .sidebar-profile {
            background-color: var(--panel-siyah-light);
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .text-orange {
            color: var(--panel-turuncu) !important;
        }
    </style>
    @RenderSection("head", required: false)
</head>
<body>

    <div class="d-flex min-vh-100">

        <!-- SOL SIDEBAR -->
        <aside class="sidebar-dark d-flex flex-column border-end border-dark">

            <!-- LOGO ALANI -->
            <div class="p-3 sidebar-header d-flex align-items-center justify-content-between">
                <a href="@Url.Action("Index", "Dashboard", new { area = "ManagerPanel" })" class="d-flex align-items-center text-decoration-none">
                    <img src="~/Assets/Images/esvak-logo.png" class="me-2" style="max-height: 38px; width: auto;" />
                </a>
                <span class="badge bg-dark text-warning border border-secondary px-2 py-1 extra-small" style="font-size:0.65rem;">MANAGER</span>
            </div>

            <!-- NAVİGASYON MENÜSÜ -->
            <nav class="p-3 w-100 flex-grow-1">

                <div class="sidebar-heading">Ana Menü</div>
                <ul class="nav nav-pills flex-column gap-1 mb-3">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "ManagerPanel" })" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Dashboard" ? "active" : "")">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Bookings", new { area = "ManagerPanel" })" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Rezervasyon Yönetimi" || ViewBag.Title == "Bookings" ? "active" : "")">
                            <i class="fa-solid fa-journal-check text-orange"></i>
                            <span>Rezervasyonlar</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-heading">İçerik Yönetimi</div>
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Tour", new { area = "ManagerPanel" })" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Tour Management" || ViewBag.Title == "Turlar" ? "active" : "")">
                            <i class="fa-solid fa-plane-departure"></i>
                            <span>Turlar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "TourCategory", new { area = "ManagerPanel" })" class="nav-link d-flex align-items-center gap-2 @(ViewBag.Title == "Category Management" || ViewBag.Title == "Kategoriler" ? "active" : "")">
                            <i class="fa-solid fa-tags"></i>
                            <span>Kategoriler</span>
                        </a>
                    </li>
                </ul>

            </nav>

            <!-- ALT ADMİN BİLGİ KARTI -->
            <div class="p-3 sidebar-profile mt-auto">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        @if (Session["ManagerName"] != null)
                        {
                            string name = Session["ManagerName"].ToString();
                            string nickName = Session["ManagerNickName"] != null ? Session["ManagerNickName"].ToString() : "Manager";
                            string firstLetter = !string.IsNullOrEmpty(name) ? name.Substring(0, 1).ToUpper() : "M";

                            <div class="rounded-circle fw-bold d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 38px; height: 38px; background-color: #ff6b00; color: white;">
                                @firstLetter
                            </div>
                            <div class="d-flex flex-column overflow-hidden" style="max-width: 140px;">
                                <span class="text-white small fw-semibold text-truncate">@name</span>
                                <span class="text-muted extra-small text-truncate" style="font-size: 0.75rem;">@@@nickName</span>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle fw-bold d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 38px; height: 38px; background-color: #ff6b00; color: white;">
                                M
                            </div>
                            <div class="d-flex flex-column">
                                <span class="text-white small fw-semibold">Yönetici Paneli</span>
                                <span class="text-muted extra-small" style="font-size: 0.75rem;">Yönetici</span>
                            </div>
                        }
                    </div>

                    <a href="@Url.Action("Logout", "ManagerLogIn", new { area = "ManagerPanel" })"
                       class="btn btn-sm btn-outline-light border-0 text-danger"
                       title="Çıkış Yap">
                        <i class="fa-solid fa-right-from-bracket fs-6"></i>
                    </a>
                </div>
            </div>

        </aside>


        <main class="flex-grow-1 p-4">
            <div class="bg-white rounded-4 p-4 shadow-sm min-vh-100">

                @RenderBody()
            </div>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>